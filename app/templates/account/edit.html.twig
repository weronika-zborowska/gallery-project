{% extends 'base.html.twig' %}

{% block title %}Edycja konta{% endblock %}

{% block body %}
    <h1>Edycja danych konta</h1>

    {{ form_start(form) }}
    {{ form_row(form.email) }}

    <button class="btn btn-primary" type="submit">Zapisz</button>
    {{ form_end(form) }}

    <a href="{{ path('app_account') }}">Wróć do konta</a>
{% endblock %}