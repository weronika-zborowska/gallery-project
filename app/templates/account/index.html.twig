{% extends 'base.html.twig' %}

{% block title %}Moje konto{% endblock %}

{% block body %}
    <h1>Moje konto</h1>

    <p>
        Zalogowano jako:
        <strong>{{ app.user.userIdentifier }}</strong>
    </p>

    <a class="btn btn-primary me-2" href="{{ path('app_account_edit') }}">
        Edytuj dane
    </a>

    <a class="btn btn-warning" href="{{ path('app_account_password') }}">
        Zmień hasło
    </a>
{% endblock %}