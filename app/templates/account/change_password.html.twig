{% extends 'base.html.twig' %}

{% block title %}Zmiana hasła{% endblock %}

{% block body %}
    <h1>Zmiana hasła</h1>

    {{ form_start(form) }}

    {{ form_row(form.currentPassword) }}
    {{ form_row(form.plainPassword) }}

    <button class="btn btn-primary" type="submit">
        Zmień hasło
    </button>

    {{ form_end(form) }}

    <a href="{{ path('app_account') }}">Wróć do konta</a>
{% endblock %}