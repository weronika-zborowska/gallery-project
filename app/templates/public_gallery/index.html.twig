{% extends 'base.html.twig' %}

{% block body %}

    <h1 class="mb-4">Galerie zdjęć</h1>

    <div class="row">

        {% for gallery in galleries %}
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm">

                    <div class="card-body">
                        <h3 class="card-title">
                            {{ gallery.title }}
                        </h3>

                        <p class="card-text">
                            {{ gallery.description }}
                        </p>

                        <a
                                href="{{ path('app_public_gallery_show', {'id': gallery.id}) }}"
                                class="btn btn-dark"
                        >
                            Otwórz galerię
                        </a>
                    </div>

                </div>

            </div>
        {% else %}
            <p>Brak galerii.</p>
        {% endfor %}

    </div>

{% endblock %}