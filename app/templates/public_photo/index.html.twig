{% extends 'base.html.twig' %}

{% block body %}

    <h1 class="mb-4">Najnowsze zdjęcia</h1>

    <div class="row">

        {% for photo in photos %}
            <div class="col-md-4 mb-4">

                <div class="card shadow-sm h-100">

                    <a href="{{ path('app_public_photo_show', {'id': photo.id}) }}">

                        <img
                                src="{{ asset('uploads/photos/' ~ photo.filename) }}"
                                class="card-img-top"
                                alt="{{ photo.title }}"
                                style="height: 300px; object-fit: cover;"
                        >

                    </a>

                    <div class="card-body">

                        <h5 class="card-title">
                            {{ photo.title }}
                        </h5>

                        <a
                                href="{{ path('app_public_photo_show', {'id': photo.id}) }}"
                                class="btn btn-dark"
                        >
                            Zobacz zdjęcie
                        </a>

                    </div>

                </div>

            </div>

        {% else %}
            <p>Brak zdjęć.</p>
        {% endfor %}

    </div>

    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(photos) }}
    </div>

{% endblock %}